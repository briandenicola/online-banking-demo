# Online Banking Demo — Environment Variables
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env (LOCAL DEV) or configure in Azure Key Vault (PRODUCTION)
#    cp .env.example .env
# 2. Fill in values marked as [REQUIRED] - others have defaults
# 3. For local development: most Azure vars are optional (leave blank if not using AI features)
# 4. For Azure production: all [REQUIRED] vars must be set before deployment
#
# VARIABLE TYPES:
# [REQUIRED]  = Must be set for that deployment scenario
# [OPTIONAL]  = Not needed; has sensible default or feature disabled if blank
# [SECRET]    = Sensitive; never commit to git; use .gitignore or Key Vault
# [DEFAULT]   = Has hardcoded fallback if not set

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Token Secret [REQUIRED] [SECRET]
# Used to sign and verify JWT tokens for authentication
# - LOCAL: Any complex string works; defaults to demo value in docker-compose.yml
# - AZURE: Generate with: openssl rand -base64 32
# - Min 32 characters recommended
Jwt__Key=YourSuperSecretKeyForJWTTokenGeneration12345

# JWT Token Issuer [OPTIONAL] [DEFAULT: user-service]
# Must match the issuer claim in generated tokens
Jwt__Issuer=user-service

# ============================================================================
# DATABASE
# ============================================================================

# Use In-Memory Database [OPTIONAL] [DEFAULT: true for local]
# Set to false to use persistent database (Cosmos DB in Azure, SQL Server for .NET)
# LOCAL: true (in-memory is sufficient for demo)
# AZURE: false (use Cosmos DB connection string below)
UseInMemoryDatabase=true

# Cosmos DB Connection String [REQUIRED for Azure production] [SECRET]
# Format: DefaultEndpoint=https://<account>.documents.azure.com:443/;AccountKey=<key>;
# LOCAL: Leave blank (not needed with in-memory database)
# AZURE: Get from Azure Portal → Cosmos DB → Keys → Primary Connection String
COSMOS_CONNECTION_STRING=

# ============================================================================
# AZURE IDENTITY & CREDENTIALS
# ============================================================================

# Azure Tenant ID [OPTIONAL] [REQUIRED for managed identity auth]
# The Azure AD tenant where resources reside
# Format: 12345678-1234-1234-1234-123456789012
# LOCAL: Leave blank if not using Azure services
# AZURE: Required for service principal or managed identity
AZURE_TENANT_ID=

# Azure Client ID [OPTIONAL] [REQUIRED for managed identity auth]
# Either managed identity client ID or service principal app ID
# Format: 12345678-1234-1234-1234-123456789012
# LOCAL: Leave blank if not using Azure services
# AZURE: Required; get from App Registrations or Managed Identity
AZURE_CLIENT_ID=

# Azure Client Secret [OPTIONAL] [REQUIRED for service principal] [SECRET]
# Service principal secret; NOT used with managed identity (use MSI instead)
# LOCAL: Leave blank
# AZURE: Set ONLY if using service principal (not recommended for production; use managed identity)
# WARNING: Never commit this to git
AZURE_CLIENT_SECRET=

# ============================================================================
# AZURE AI & LANGUAGE SERVICES
# ============================================================================

# Azure AI Agents Endpoint [OPTIONAL]
# Used by chatbot service for AI-powered financial assistant
# Format: https://<resource-name>.cognitiveservices.azure.com/
# LOCAL: Leave blank to disable chatbot AI features
# AZURE: Required if using chatbot service
# Get from: Azure Portal → Azure AI Foundry → Settings → Endpoint URL
AZURE_AI_AGENTS_ENDPOINT=

# Azure OpenAI Endpoint [OPTIONAL]
# Used by anomaly detection and budget services
# Format: https://<resource-name>.openai.azure.com/
# LOCAL: Leave blank to disable anomaly/budget AI features
# AZURE: Required for production deployments
# Get from: Azure Portal → Azure OpenAI → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI Model Deployment Name [OPTIONAL] [DEFAULT: gpt-4o-mini]
# Name of the deployment in Azure OpenAI (e.g., gpt-4, gpt-35-turbo, gpt-4o-mini)
# LOCAL: Leave blank (not used if AZURE_OPENAI_ENDPOINT is blank)
# AZURE: Must match a deployment in your Azure OpenAI resource
AZURE_OPENAI_MODEL=gpt-4o-mini

# Azure AI Agent Project Connection String [OPTIONAL]
# Connection string for Azure AI Agent Service (for advanced AI orchestration)
# Format: endpoint=https://<resource>.cognitiveservices.azure.com/;subscription=<key>;
# LOCAL: Leave blank
# AZURE: Required only if using advanced AI Agent features
# Get from: Azure AI Foundry → Project Settings → Project connection string
AZURE_AI_AGENT_PROJECT_CONNECTION_STRING=

# Azure OpenAI Deployment [OPTIONAL]
# Alternative to AZURE_OPENAI_MODEL; specifies deployment name for Azure OpenAI
# Use ONE of: AZURE_OPENAI_MODEL or AZURE_OPENAI_DEPLOYMENT
AZURE_OPENAI_DEPLOYMENT=

# ============================================================================
# REDIS CACHE & EVENT BUS
# ============================================================================

# Redis Connection String [OPTIONAL] [DEFAULT: redis:6379 in docker-compose]
# Used by: transaction service, transfer service, anomaly service, event processor
# For events, caching, and distributed state management
# Format: host:port or connection-string for managed Redis
# LOCAL: redis:6379 (docker internal network)
# AZURE: <redis-name>.redis.cache.windows.net:6380
# Note: Docker Compose exposes Redis on 6380 externally; 6379 internally
REDIS__CONNECTIONSTRING=redis:6379

# ============================================================================
# SERVICE-TO-SERVICE COMMUNICATION (URLs)
# ============================================================================

# Account Service URL [OPTIONAL] [DEFAULT: http://account-service:8080]
# Used by transfer service to call account service
# LOCAL: http://account-service:8080 (docker internal network)
# AZURE: https://account-service.banking-demo.svc.cluster.local (Kubernetes DNS)
Services__AccountService=http://account-service:8080

# Transaction Service URL [OPTIONAL] [DEFAULT: http://transaction-service:8080]
# Used by transfer service to query transaction history
# LOCAL: http://transaction-service:8080 (docker internal network)
# AZURE: https://transaction-service.banking-demo.svc.cluster.local (Kubernetes DNS)
Services__TransactionService=http://transaction-service:8080

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Application Insights Connection String [OPTIONAL]
# Telemetry ingestion for logging, metrics, traces, dependencies
# Format: InstrumentationKey=<key>; or DefaultEndpointProtocol=https;EndpointSuffix=...
# LOCAL: Leave blank (no telemetry)
# AZURE: Required for production; get from Azure Portal → Application Insights → Settings
# Impact: When set, application insights SDK starts sending telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ============================================================================
# CORS & SECURITY
# ============================================================================

# Allowed CORS Origins [OPTIONAL]
# Comma-separated list of origins allowed to make cross-origin requests
# LOCAL: localhost:3000, localhost:80
# AZURE: https://banking-demo.azurewebsites.net
# Format: https://domain.com,https://api.domain.com (no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ============================================================================
# TLS / CUSTOM DOMAIN
# ============================================================================

# Custom Domain [REQUIRED for TLS setup]
# Required for TLS setup. Set your custom domain here.
# Used by cert-manager Certificate and Istio Gateway for TLS termination.
# Format: banking.example.com (no protocol prefix)
# LOCAL: Not needed
# AZURE: Must match the DNS A record pointing to the Istio ingress gateway IP
CUSTOM_DOMAIN=banking.example.com

# ============================================================================
# DEPLOYMENT CONTEXT
# ============================================================================

# ASP.NET Core Environment [OPTIONAL] [DEFAULT: Development]
# Values: Development, Staging, Production
# Affects logging verbosity, startup messages, error handling
ASPNETCORE_ENVIRONMENT=Development
