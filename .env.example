# Azure AI Configuration
# For Azure AI Foundry (new format): https://<project-name>.<region>.api.azureai.ms
# For Azure OpenAI: https://<resource-name>.openai.azure.com/
AZURE_AI_AGENTS_ENDPOINT=https://<your-project>.<your-region>.api.azureai.ms

# Model deployment name (e.g., gpt-4o-mini, gpt-4-turbo)
AZURE_OPENAI_MODEL=gpt-4o-mini