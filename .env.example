# Online Banking Demo — Environment Variables
# Copy to .env and fill in values before running `docker-compose up`

# JWT Security (REQUIRED — used by gateway and backend services)
JWT_KEY=CHANGE_ME_TO_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ISSUER=user-service

# Azure AI / OpenAI
AZURE_AI_AGENTS_ENDPOINT=https://<your-ai-foundry>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_CLIENT_ID=<managed-identity-client-id>

# Redis (event bus — used by transaction, transfer, anomaly, event-processor services)
# Default is redis:6379 when running in docker-compose; override for external Redis
REDIS__CONNECTIONSTRING=redis:6379

# Azure Application Insights (telemetry)
APPLICATIONINSIGHTS_CONNECTION_STRING=
