# Online Banking Demo — Environment Variables
#
# Copy this file to .env:  cp .env.example .env
#
# Local dev: docker-compose supplies all defaults — no edits needed.
# Azure:     Terraform outputs + Key Vault CSI provide everything automatically.
#            Only CUSTOM_DOMAIN requires manual input (for TLS setup).

# Custom domain for TLS termination (optional)
# Set this before running: task cloud:tls:enable
# Must match the DNS A record pointing to the Istio ingress gateway IP
# Format: banking.example.com (no protocol prefix)
CUSTOM_DOMAIN=

# Python/FastAPI services (local overrides)
# JWT_KEY is mapped into services for token validation.
JWT_KEY=YourSuperSecretKeyForJWTTokenGeneration12345
JWT_ISSUER=user-service
JWT_AUDIENCE=banking-demo
JWT_EXPIRES_IN_MINUTES=60

# Redis connection string for Python services (local docker-compose default shown)
REDIS_CONNECTION_STRING=redis:6379

# Cosmos DB endpoint for chat/account opening persistence (optional)
COSMOS_DB_ENDPOINT=

# Chatbot Agent Memory Toolkit MVP (optional; disabled by default)
# Requires Cosmos DB, Azure AI Foundry chat deployment, and embedding deployment.
CHAT_MEMORY_ENABLED=false
CHAT_MEMORY_REQUIRED=false
CHAT_MEMORY_DATABASE=BankingDemo
CHAT_MEMORY_CONTAINER=AgentMemories
CHAT_MEMORY_TURNS_CONTAINER=AgentMemoryTurns
CHAT_MEMORY_SUMMARIES_CONTAINER=AgentMemorySummaries
CHAT_MEMORY_COUNTER_CONTAINER=AgentMemoryCounters
CHAT_MEMORY_LEASE_CONTAINER=AgentMemoryLeases
CHAT_MEMORY_MAX_CONTEXT_TURNS=8
CHAT_MEMORY_MAX_FACTS=5
CHAT_MEMORY_MAX_PROMPT_CHARS=4000
CHAT_MEMORY_MIN_CONFIDENCE=0.7
CHAT_MEMORY_PROCESS_EVERY_N_TURNS=2
CHAT_MEMORY_RECONCILE_EVERY_N_TURNS=8
CHAT_MEMORY_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
