      "key": "l1-pending-needs-you",
      "proposer": "banker",
      "actionId": "account.balance.adjust",
      "after": "leave-pending",
      "payload": {
        "accountId": {
          "@ref": "evidenceAccountId"
        },
        "amount": {
          "@threshold": "balance_adjustment_dual_control_amount",
