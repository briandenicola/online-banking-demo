      "key": "l1-pending-needs-you",
      "proposer": "banker",
      "actionId": "account.balance.adjust",
      "after": "leave-pending",
      "payload": {
        "accountId": {
          "@ref": "primaryAccountId"
        },
        "amount": {
          "@threshold": "balance_adjustment_dual_control_amount",
          "@delta": -30
        },
        "direction": "debit",
        "reason": "Duplicate ATM fee charged twice in the same statement cycle."
      },
