{
  "openapi": "3.0.1",
  "info": {
    "title": "Transfer Service",
    "version": "v1"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "transfer-service, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "transfer-service, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Transfers": {
      "post": {
        "tags": [
          "Transfers"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransferRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransferRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransferRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Transfers/{id}": {
      "get": {
        "tags": [
          "Transfers"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTransferRequest": {
        "required": [
          "amount",
          "fromAccountId",
          "fromAccountNumber",
          "toAccountId",
          "toAccountNumber"
        ],
        "type": "object",
        "properties": {
          "fromAccountId": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "toAccountId": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "fromAccountNumber": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "toAccountNumber": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "amount": {
            "maximum": 1000000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "description": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT Authorization header using the Bearer scheme",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}