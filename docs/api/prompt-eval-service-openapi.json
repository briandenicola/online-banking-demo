  "components": {
    "schemas": {
      "ComparisonResponse": {
        "type": "object",
        "properties": {
          "run1": {
            "$ref": "#/components/schemas/EvaluationRunSummary"
          },
          "run2": {
            "$ref": "#/components/schemas/EvaluationRunSummary"
          },
          "deltas": {
            "$ref": "#/components/schemas/ScoreDeltas"
          }
        },
        "additionalProperties": false
      },
      "CreatePromptTemplateRequest": {
        "required": [
          "name",
          "systemPrompt",
          "target"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "target": {
            "minLength": 1,
            "pattern": "^(risk-scoring|categorization)$",
            "type": "string"
          },
          "systemPrompt": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
