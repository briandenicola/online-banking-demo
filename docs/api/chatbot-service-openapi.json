        }
      }
    },
    "/api/admin/scored-transactions/{tx_id}": {
      "get": {
        "summary": "Get Scored Transaction",
        "operationId": "get_scored_transaction_api_admin_scored_transactions__tx_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "tx_id",
            "in": "path",
