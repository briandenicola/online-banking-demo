# Build outputs
**/bin/
**/obj/
**/build/
**/.vs/

# Terraform
infra/cloud/.terraform/
infra/cloud/terraform.tfstate.d/
infra/cloud/*.tfstate
infra/cloud/*.tfstate.backup

infra/local/.terraform/
infra/local/terraform.tfstate.d/
infra/local/*.tfstate
infra/local/*.tfstate.backup

# Provider lock files — environments are disposable, providers float
**/.terraform.lock.hcl


# IDE
.idea/
.vscode/
*.swp
*.sln

# Environment
.env
.env.local
*.user
*.suo

# Docker
.docker/

# Node modules
node_modules/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
*.pyo
.env
.venv/
venv/
*.egg-info/

# Go
/dist/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
# Squad: ignore runtime state (logs, inbox, sessions)
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

**/obj.root/
**/bin.root/
**/obj2/
**/build-intermediate/

# Stale build artifacts
#
# These are workaround directories created when the real obj/ or bin/ is owned
# by root (left behind by an old containerised build) and cannot be written or
# deleted without sudo. Each one is a scar, not a design: the actual fix is to
# remove the root-owned directories. Keep this list in sync with
# DefaultItemExcludes in src/Directory.Build.props, or the compiler will happily
# pick up a stale duplicate of every source file it finds here.
obj.old/
bin.old/
**/obj.root*/
**/bin.root*/
**/obj.basher/
**/bin.basher/
*.old
