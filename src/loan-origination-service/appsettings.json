{
  "CosmosDb": {
    "ConnectionString": "UseDevelopmentEmulator=true",
    "DatabaseName": "BankingDemo",
    "ApplicationsContainerName": "loan-applications",
    "RunsContainerName": "loan-runs",
    "DecisionsContainerName": "underwriting-decisions",
    "PolicyContainerName": "loan-policy",
    "AccountsContainerName": "loan-accounts",
    "DisbursementsContainerName": "loan-disbursements"
  },
  "Foundry": {
    "Endpoint": "",
    "Mode": "online"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "StreamName": "banking-events"
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyForJWTTokenGeneration12345",
    "Issuer": "user-service",
    "Audience": "banking-demo"
  },
  "Services": {
    "UserService": "http://user-service:8080"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
