FROM mcr.microsoft.com/azurelinux/base/python:3.12

WORKDIR /app

# Install az CLI + network/HTTP diagnostic tools so we can hit the Foundry
# project endpoint directly from inside the managed VNet (issue #145).
RUN tdnf install -y \
        curl \
        ca-certificates \
        jq \
        bind-utils \
        iputils \
        openssl \
        less \
        procps-ng \
    && curl -sL https://aka.ms/InstallAzureCLIDeb | bash \
    && tdnf clean all

COPY ./app ./app
COPY ./pyproject.toml ./

RUN pip install --no-cache-dir --root-user-action=ignore .

# Match the runAsUser=1000 in eval-debug.yaml.
USER 1000

CMD ["sleep", "infinity"]
